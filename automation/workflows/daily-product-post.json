      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HF_IMAGE_URL || 'https://router.huggingface.co/hf-inference/models/black-forest-labs/FLUX.1-schnell' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.HF_TOKEN }}"
