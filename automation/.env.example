# Copy to .env and fill in. NEVER commit .env.

# ---- Brand ----
BRAND_NAME=Nirmal Aqua
SHOP_URL=                      # optional, used by the --no-ai template caption

# ---- Google Sheet ----
GOOGLE_SHEET_ID=               # n8n: ID from the sheet URL (docs.google.com/spreadsheets/d/<ID>/edit)
SHEET_CSV_URL=                 # script only: "Publish to web" CSV URL (read-only); or use products.csv

# ---- AI ----
GROQ_API_KEY=                  # https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
HF_TOKEN=                      # https://huggingface.co/settings/tokens (read/inference permission)
HF_IMAGE_URL=https://router.huggingface.co/hf-inference/models/black-forest-labs/FLUX.1-schnell

# ---- Public image hosting ----
IMGBB_API_KEY=                 # https://api.imgbb.com/

# ---- Instagram (Meta Graph API) ----
IG_USER_ID=                    # Instagram Business/Creator account id (numeric)
IG_ACCESS_TOKEN=               # long-lived token with instagram_content_publish
GRAPH_API_VERSION=v21.0

# ---- WhatsApp Status via WAHA (bonus) ----
WHATSAPP_API_KEY=change-me-long-random   # sent as X-Api-Key; also protects WAHA itself
WAHA_SESSION=default           # WAHA Core only supports the session name "default"
WAHA_URL=http://localhost:3000 # script only (n8n uses http://waha:3000 on the docker network)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me

# ---- n8n ----
N8N_ENCRYPTION_KEY=change-me-long-random
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false        # set true when served over https
TIMEZONE=Asia/Kolkata
